{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // This repo is a BUNDLE OF CLIs, not an application. Almost every
  // scripts/*.mjs is invoked by an npm script, a git hook, or by hand — none
  // has an importer. They must all be entry points or the entire repo reads as
  // dead code.
  "entry": [
    // install.mjs is package.json "bin" (knip finds it itself); setup.mjs is not.
    "setup.mjs",

    // Every top-level CLI + the per-subsystem CLIs (symbol-index/, security-memory/, …).
    // scripts/lib/** is deliberately NOT an entry: those are real libraries, and
    // a lib nobody imports is exactly the signal we want to keep.
    "scripts/**/*.mjs",
    "!scripts/lib/**",

    // Claude Code hooks — spawned by the harness on UserPromptSubmit / PostToolUse.
    ".claude/hooks/*.mjs",

    "tests/**/*.test.mjs",

    // Playwright specs are entry points for the SAME reason the CLIs are: they
    // are run by `npx playwright test`, never imported, so knip's static import
    // graph cannot see the caller. Declared as an entry rather than baselined —
    // a baseline entry means "known unused code we tolerate", which would be a
    // false statement about a spec that runs and asserts.
    "tests/e2e/**/*.spec.mjs",

    // Test-guard fixtures, for the SAME reason as the playwright specs above:
    // they are executed by being named on a `node --test` command line that
    // tests/test-guard-false-green.test.mjs builds at runtime, so no static
    // import graph can reach them. They are `.fixture.mjs`, NOT `.test.mjs`,
    // precisely so the default `tests/*.test.mjs` glob cannot pick them up —
    // one of them is deliberately broken, and it must only ever run under the
    // suite that asserts the guard catches it.
    "tests/fixtures/test-guard/*.fixture.mjs"
  ],

  "project": [
    "scripts/**/*.mjs",
    ".claude/hooks/*.mjs",
    "tests/**/*.mjs"
  ],

  // .claude/skills/** (generated by skills:regenerate) and dashboard/*.html
  // (Category-A artifacts) need no entry here — they already fall outside
  // "project", and knip flags a never-matching ignore as a config hint.
  //
  // docs/plans/security/files/** DOES need one. It is a plan-doc SNAPSHOT of
  // source — the same bundle scripts/lib/audit/orphan-introduced.mjs excludes
  // via isDocExampleFile — and its relative imports deliberately do not resolve
  // from where it sits. Being outside "project" is not enough: knip's test-file
  // globbing reaches `**/*.test.mjs` anywhere in the repo, so without this the
  // snapshot contributes 3 permanent phantom "unresolved import" findings.
  // tests/fixtures/anchor-contract/files/** is the same class: HEAD-side
  // snapshots of source, committed so the anchor-contract probe's model input is
  // immutable (a pinned diff alone is only half of it — readFilesAsContext reads
  // the live worktree). Nothing imports them and nothing should; they are data
  // that happens to be .mjs. Ignored rather than baselined, because a baseline
  // entry says "known unused code we tolerate" and these are not code at all.
  "ignore": [
    "docs/plans/security/files/**",
    "tests/fixtures/anchor-contract/files/**"
  ],

  // @stryker-mutator/core is SPAWNED, never imported: scripts/mutation-test.mjs
  // shells out to `npx stryker run <generated-config>`, because Stryker is a
  // process-level instrument that re-runs the test command per mutant. Knip
  // resolves usage statically, so a spawned binary is invisible to it.
  //
  // Ignored rather than baselined, deliberately. A baseline entry means "known
  // unused, tolerated" — which would be a false statement here and would go
  // stale silently the day someone deleted the runner. This says the true
  // thing: it IS used, just not through an import graph.
  "ignoreDependencies": [
    "@stryker-mutator/core"
  ]
}
