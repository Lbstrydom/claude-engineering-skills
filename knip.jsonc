{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // This repo is a BUNDLE OF CLIs, not an application. Almost every
  // scripts/*.mjs is invoked by an npm script, a git hook, or by hand — none
  // has an importer. They must all be entry points or the entire repo reads as
  // dead code.
  "entry": [
    // install.mjs is package.json "bin" (knip finds it itself); setup.mjs is not.
    "setup.mjs",

    // Every top-level CLI + the per-subsystem CLIs (symbol-index/, security-memory/, …).
    // scripts/lib/** is deliberately NOT an entry: those are real libraries, and
    // a lib nobody imports is exactly the signal we want to keep.
    "scripts/**/*.mjs",
    "!scripts/lib/**",

    // Claude Code hooks — spawned by the harness on UserPromptSubmit / PostToolUse.
    ".claude/hooks/*.mjs",

    "tests/**/*.test.mjs"
  ],

  "project": [
    "scripts/**/*.mjs",
    ".claude/hooks/*.mjs",
    "tests/**/*.mjs"
  ],

  // .claude/skills/** (generated by skills:regenerate) and dashboard/*.html
  // (Category-A artifacts) need no entry here — they already fall outside
  // "project", and knip flags a never-matching ignore as a config hint.
  //
  // docs/plans/security/files/** DOES need one. It is a plan-doc SNAPSHOT of
  // source — the same bundle scripts/lib/audit/orphan-introduced.mjs excludes
  // via isDocExampleFile — and its relative imports deliberately do not resolve
  // from where it sits. Being outside "project" is not enough: knip's test-file
  // globbing reaches `**/*.test.mjs` anywhere in the repo, so without this the
  // snapshot contributes 3 permanent phantom "unresolved import" findings.
  "ignore": [
    "docs/plans/security/files/**"
  ]
}
