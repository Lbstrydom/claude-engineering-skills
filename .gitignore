node_modules/
*.log
/tmp/

# API keys and secrets — .env plus any profile variant (.env.work-test, .env.local, …).
# The negation keeps the committed annotated example visible.
.env
.env.*
!.env.example

# Skills fit-check diagnostic — per-environment report, regenerated by
# `npm run skills:fit-check`. Adopters may choose to commit theirs; in
# the source repo it is incidental.
.skills-fit-check.json

# IDE settings (per-machine)
.claude/settings.local.json
.claude/worktrees/

# Private/corporate consumer registry — names a non-public consumer repo,
# must never be committed to this public repo (see consumer-repos.local.example.json).
scripts/lib/consumer-repos.local.json
.claude/scheduled_tasks.lock

# Audit-loop operational state (local to each machine)
# ALL of it. `.audit/` is our directory — only audit-loop tooling writes
# there, and every skill run adds new `--out .audit/<session>-…` artifacts
# (transcripts, ledgers, patches, stderr logs). This was 50 filename
# patterns and STILL lost the race: `.audit/.audit-cache-*/` was nagging
# as untracked when this was consolidated. Enumerating a set that grows
# on every run is a treadmill you lose silently. Nothing under .audit/ is
# tracked (verified: `git ls-files .audit/` is empty), so the directory
# rule is both correct and complete. Mirrors the consumer managed block
# (scripts/sync-to-repos.mjs MANAGED_IGNORE_PATTERNS).
.audit/
# Brainstorm session ledger + saved insights (per-machine state)
.brainstorm/

# Human adjudication worksheets — regenerated on every queue listing
# (Category-A volatile state; discoverable next to the session archives)
docs/arm-eval/worksheets/

# Install receipt + transaction journal (per-machine state)
# .tmp.<pid>.<timestamp>.<rand> suffix is the in-flight write-then-rename
# pattern; bare .json without .tmp. suffix is the final receipt.
.audit-loop-install-receipt.json
.audit-loop-install-txn.json
.audit-loop-install-txn.json.tmp.*
# The transaction lock. This repo installs its own bundle, so it produces the
# same Category-A artefacts a consumer does — gitignore.mjs adds this pattern to
# CONSUMER repos, but this repo's own .gitignore is hand-maintained and missed it.
.audit-loop-install-txn.json.lock

# Stale artifact from early development
--db-path

# Architectural-memory cache (regenerated, never commit).
.audit-loop/cache/

# Observed domain-deps envelope — derived from DB import graph by arch:render.
.audit-loop/domain-deps-observed.json

# /nav-audit observed nav graph + local drift-aging cache — regenerated each
# run (Category-A: volatile provenance), never committed. Aging is cloud-sourced.
.audit-loop/nav-graph-observed.json
.audit-loop/nav-drift-ledger.json
.audit-loop/nav-verify-result.json

# /visual-audit observed allowed-set + live verify-result + local drift cache —
# regenerated each run (Category-A: volatile provenance), never committed.
.audit-loop/visual-observed.json
.audit-loop/visual-verify-result.json
.audit-loop/visual-drift-ledger.json

# Repo-identity reconcile intermediate — operator-curated, one-time, applied
# then spent (the merge it proposes lands in the DB, not the repo). Like the
# requirements-layer candidates/gaps intermediates: kept locally, never committed.
.audit-loop/repo-alias-map.json

# Per-repo experiment toggle (arm-eval-toggle on|off) — local operator state
# with a timestamp; never committed (Category A).
.audit-loop/arm-eval-toggle.json

# Local weekly-maintenance heartbeat + backgrounded-run log + single-instance
# lock — all timestamped/transient, regenerated every run (Category A).
# See scripts/maintenance-checks.mjs. (round-4 Gemini gate G2 fix: the log +
# lock files were introduced by later fixes but never added here.)
.audit-loop/last-maintenance.json
.audit-loop/last-maintenance.log
.audit-loop/.maintenance.lock

# Solo author-model control (scripts/solo-control-audit.mjs) — S findings, the
# blind adjudication sheet, and its private unblind map. Derived from DB + git +
# an LLM call (Category A); the private map must never be committed.
.audit-loop/solo-control/

# SOURCE-repo sync manifest — regenerated on every `npm run sync` (which the
# pre-push hook runs), carrying volatile provenance (generatedAt timestamp +
# HEAD sha) → Category A per the generated-artifact policy: committing it is pure
# churn (dirty again on the next push). The file still exists on disk for readers;
# it's just untracked HERE. CONSUMERS still track their own copy (the isolation
# verifier needs it; synced + eol-pinned via .gitattributes) — this ignore is
# source-only and does NOT propagate to the consumer managed .gitignore block.
scripts/.sync-manifest.json

# .env backups from rearrangement scripts (may contain secrets).
.env.bak.*

# Brainstorm temp files: topic stdin + malformed-payload debug JSONs (0o600).
.claude/tmp/

# Requirements layer — extraction intermediates are regenerable; the
# reconciled ledger + hand-curated overrides ARE committed (shared rubric).
.requirements/candidates.json
.requirements/gaps.json
.requirements/.lock

# Playwright MCP session artifacts — screenshots / DOM snapshots / console
# logs written by /persona-test runs. Transient, per-machine, never committed.
.playwright-mcp/
persona-step*.png
persona-final-*.png

# Local dashboard — BOTH pages are locally-built, per-machine artifacts,
# never committed. `npm run dashboard` rebuilds them on serve; nothing reads a
# committed copy (no GitHub Pages / public showcase — confirmed with the owner
# 2026-06). The reference page WAS committed under an earlier asymmetric policy
# (docs/plans/local-dashboard.md §2.1) but it embeds a "built from <SHA>"
# banner, so the pre-push rebuild re-dirtied it on every push and it could never
# be clean. Retired: a generated view of repo+cloud state is not source — it
# belongs in the same "derived → gitignored" category as domain-deps-observed.json.
dashboard/index.html
dashboard/telemetry.html
# Per-run audit-findings pages (docs/plans/dashboard-audit-run-viewer.md) —
# same category-A "derived → gitignored" rule; sourced from the durable cloud
# audit_findings, rebuilt per run, never committed.
dashboard/audit-runs/

# Persona-test consistency mode — session ledgers + LLM-egress derived
# state. Per-machine artifacts; surfaces.json + canaries/*.json ARE
# committed (the manifest + reference journeys are shared rubric).
# See docs/plans/persona-test-consistency-mode.md.
.persona-test/sessions/
.persona-test/semantic-cache.json
.persona-test/semantic-cache.json.lock
.persona-test/semantic-egress.log
.persona-test/semantic-egress.log.*
.persona-test/promotion-journal/
