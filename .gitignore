node_modules/
*.log
/tmp/

# API keys and secrets
.env

# IDE settings (per-machine)
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# Audit-loop operational state (local to each machine)
.audit/local/
.audit/staging/
.audit/quarantine/
.audit/**/*.lock
.audit/outcomes.jsonl
.audit/experiments.jsonl
.audit/experiment-manifests/
.audit/prompt-revisions/
.audit/bandit-state.json
.audit/fp-tracker.json
.audit/remediation-tasks.jsonl
.audit/pipeline-state.json
.audit/session-ledger.json
.audit/meta-assessments.jsonl
.audit/session-audit-*.json
.audit/quickfix-hits.jsonl
# Phase 1+2+3 + friction-log adaptive-learning local state
.audit/learning-outbox/
.audit/learning-failed-writes.jsonl
.audit/friction-log.jsonl
.audit/quickfix-pattern-stats.json
.audit/quickfix-hits.drained-offset

# Brainstorm session ledger + saved insights (per-machine state)
.brainstorm/

# Per-run audit artifacts (results, transcripts, rebuttals)
.audit/*-result.json
.audit/*-stderr.log
.audit/*-transcript.json
.audit/*-rebuttal.md
.audit/*-resolution.json
.audit/*-debt-review.md
.audit/*-meta-assessment.md
.audit/*-ledger.json
.audit/gemini-result.json

# Install receipt + transaction journal (per-machine state)
# .tmp.<pid>.<timestamp>.<rand> suffix is the in-flight write-then-rename
# pattern; bare .json without .tmp. suffix is the final receipt.
.audit-loop-install-receipt.json
.audit-loop-install-txn.json
.audit-loop-install-txn.json.tmp.*

# Author-private self-audit artefacts (this repo auditing itself)
.audit/tech-debt.json
.audit/vendoring-provenance.json

# Stale artifact from early development
--db-path

# Architectural-memory cache (regenerated, never commit).
.audit-loop/cache/

# .env backups from rearrangement scripts (may contain secrets).
.env.bak.*

# Brainstorm temp files: topic stdin + malformed-payload debug JSONs (0o600).
.claude/tmp/
.audit/orphan-metrics.jsonl
