{
  "name": "claude-engineering-skills",
  "version": "1.0.0",
  "description": "Self-driving plan-audit-fix loop with adaptive learning. 3 models: Claude + GPT-5.4 + Gemini 3.1 Pro.",
  "type": "module",
  "bin": {
    "claude-engineering-skills": "install.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/claudemd/*.test.mjs tests/install/*.test.mjs",
    "test:db": "node --test tests/repo-identity-store.test.mjs",
    "audit": "node scripts/audit-loop.mjs",
    "audit:full": "node scripts/audit-full.mjs",
    "audit:plan": "node scripts/openai-audit.mjs plan",
    "audit:code": "node scripts/openai-audit.mjs code",
    "audit:rebuttal": "node scripts/openai-audit.mjs rebuttal",
    "audit:gemini-review": "node scripts/gemini-review.mjs review",
    "audit:gemini-ping": "node scripts/gemini-review.mjs ping",
    "anthropic:ping": "node scripts/anthropic-ping.mjs",
    "azure:limits": "node scripts/azure-limits.mjs",
    "audit:refine": "node scripts/refine-prompts.mjs",
    "audit:bandit": "node scripts/bandit.mjs stats",
    "audit:phase7": "node scripts/phase7-check.mjs",
    "cache:check": "node scripts/cache-hitrate-check.mjs",
    "cache:check:json": "node scripts/cache-hitrate-check.mjs --json",
    "audit:check-deps": "node scripts/check-deps.mjs",
    "memory:health": "node scripts/memory-health.mjs",
    "memory:health:json": "node scripts/memory-health.mjs --json",
    "context:check": "node scripts/check-context-drift.mjs --strict",
    "context:check:json": "node scripts/check-context-drift.mjs --format json",
    "context:check:sarif": "node scripts/check-context-drift.mjs --format sarif",
    "models:freshness": "node scripts/check-model-freshness.mjs",
    "models:freshness:json": "node scripts/check-model-freshness.mjs --format json",
    "models:check": "node scripts/check-model-freshness.mjs --strict",
    "check": "npm run context:check && npm run skills:check && npm run plans:lint && npm test",
    "check:integration": "node scripts/symbol-index/refresh.mjs --full && node scripts/setup-postgres.mjs --check-drift",
    "db:check-drift": "node scripts/setup-postgres.mjs --check-drift",
    "db:check-drift:json": "node scripts/setup-postgres.mjs --check-drift --format json",
    "db:check-rls": "node scripts/check-rls.mjs",
    "db:check-rls:json": "node scripts/check-rls.mjs --format json",
    "db:migrate": "node scripts/setup-postgres.mjs --migrate",
    "db:adopt": "node scripts/setup-postgres.mjs --adopt",
    "setup:cloud": "node scripts/setup-cloud.mjs",
    "sync": "node scripts/sync-to-repos.mjs",
    "sync:refresh": "node scripts/sync-refresh.mjs",
    "sync:dry": "node scripts/sync-to-repos.mjs --dry-run",
    "sync:check": "node scripts/check-sync.mjs",
    "sync:version-check": "node scripts/check-audit-tool-version.mjs",
    "skills:regenerate": "node scripts/sync-shared-audit-refs.mjs && node scripts/regenerate-skill-copies.mjs",
    "skills:check": "node scripts/check-skill-refs.mjs && node scripts/sync-shared-audit-refs.mjs --check && node scripts/regenerate-skill-copies.mjs --check",
    "audit:sync-shared-refs": "node scripts/sync-shared-audit-refs.mjs",
    "skills:manifest": "node scripts/build-manifest.mjs",
    "skills:manifest:check": "node scripts/build-manifest.mjs --check",
    "skills:index": "node scripts/skills-help.mjs --out docs/SKILLS-INDEX.md",
    "skills:help": "node scripts/skills-help.mjs",
    "skills:fit-check": "node scripts/skills-fit-check.mjs",
    "dashboard": "node scripts/build-dashboard.mjs serve",
    "dashboard:build": "node scripts/build-dashboard.mjs all",
    "dashboard:setup": "npm run arch:refresh && npm run arch:render && npm run dashboard:build",
    "arch:refresh": "node scripts/symbol-index/refresh.mjs",
    "arch:refresh:full": "node scripts/symbol-index/refresh.mjs --full",
    "arch:render": "node scripts/symbol-index/render-mermaid.mjs",
    "arch:drift": "node scripts/symbol-index/drift.mjs",
    "arch:duplicates": "node scripts/symbol-index/duplicates.mjs",
    "arch:prune": "node scripts/symbol-index/prune.mjs",
    "security:refresh": "node scripts/security-memory/refresh-incidents.mjs",
    "arch:spike": "node scripts/symbol-index/spike-extract.mjs",
    "learning:weekly-review": "node scripts/cross-skill.mjs learning-weekly-review",
    "learning:stats": "node scripts/cross-skill.mjs learning-stats",
    "learning:record": "node scripts/cross-skill.mjs learning-record",
    "learning:quickfix-stats": "node scripts/cross-skill.mjs learning-quickfix-stats",
    "learning:quickfix-rebuild": "node scripts/cross-skill.mjs learning-quickfix-stats --action rebuild",
    "learning:quickfix-bootstrap": "node scripts/cross-skill.mjs learning-quickfix-stats --action rebuild --bootstrap",
    "learning:backfill-outcomes": "node scripts/cross-skill.mjs learning-backfill-outcomes",
    "learning:replay": "node scripts/cross-skill.mjs learning-replay",
    "plans:archive": "node scripts/archive-completed-plans.mjs",
    "plans:archive:dry": "node scripts/archive-completed-plans.mjs --dry-run --format human",
    "plans:lint": "node scripts/lint-plan-mermaid.mjs",
    "plans:lint:json": "node scripts/lint-plan-mermaid.mjs --format json",
    "hooks:install": "node scripts/install-prepush-hook.mjs --format human",
    "hooks:install:dry": "node scripts/install-prepush-hook.mjs --dry-run --format human",
    "hooks:uninstall": "node scripts/install-prepush-hook.mjs --uninstall --format human",
    "audit:wtf": "node scripts/friction-log.mjs",
    "parity:check-refs": "node scripts/postgres-parity/check-non-core-references.mjs",
    "parity:check-refs:strict": "node scripts/postgres-parity/check-non-core-references.mjs --strict",
    "parity:check-coupling": "node scripts/postgres-parity/check-non-core-references.mjs --schema-coupling --strict",
    "parity:expected-schema": "node scripts/postgres-parity/generate-expected-schema.mjs",
    "parity:record-fixtures": "node scripts/postgres-parity/record-golden-fixtures.mjs"
  },
  "keywords": [
    "claude",
    "gpt",
    "openai",
    "audit",
    "code-review",
    "plan-review",
    "multi-model",
    "claude-code",
    "skill"
  ],
  "author": "Louis Strydom",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@google/genai": "^1.50.1",
    "codeowners-utils": "^1.0.2",
    "dotenv": "17.4.2",
    "micromatch": "^4.0.8",
    "openai": "6.34.0",
    "pg": "^8.20.0",
    "playwright": "^1.60.0",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.8.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "dependency-cruiser": "^17.3.10",
    "ts-morph": "^28.0.0"
  }
}
