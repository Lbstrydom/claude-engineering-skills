  "_comment_purposes": "Outcome/purpose taxonomy + domain->purpose edges for the dashboard Purpose tab (docs/completed/dashboard-purpose-view.md). purposes: curated outcome nodes (7); kind=skill-chain when backed by flows.json node ids, else curated. domainPurposes: manual domain->purpose edges; a domain may serve several purposes (rendered with an 'also serves N' badge). Unmapped domains + domains absent from the architecture map surface as hygiene warnings in the tab.",
  "purposes": [
    { "id": "plan-and-design",       "label": "Plan & design work",            "kind": "skill-chain", "flowNodes": ["plan", "audit-plan"], "summary": "Turn intent into an audited, buildable plan." },
    { "id": "deliver-quality-audits","label": "Deliver quality audits",         "kind": "skill-chain", "flowNodes": ["audit-code"],          "summary": "Multi-pass GPT + Gemini code audit driven to a clean gate." },
    { "id": "verify-live-ux",        "label": "Verify live UX",                "kind": "skill-chain", "flowNodes": ["ux-lock", "persona-test"], "summary": "Lock DOM contracts and run narrative + structural UX QA on the deployed app." },
    { "id": "learn-from-outcomes",   "label": "Learn & improve from outcomes", "kind": "curated",     "flowNodes": [],                      "summary": "Close the loop: FP tracking, bandit selection, prompt evolution, recurrence health." },
    { "id": "preserve-trust-safety", "label": "Preserve trust & safety",       "kind": "curated",     "flowNodes": [],                      "summary": "Secret exclusion, RLS, redaction, atomic writes, graceful degradation." },
    { "id": "ship-and-sync",         "label": "Ship & sync",                   "kind": "skill-chain", "flowNodes": ["ship"],                "summary": "Commit, push, and propagate the bundle to consumer repos." },
    { "id": "understand-the-repo",   "label": "Understand the repo",           "kind": "curated",     "flowNodes": [],                      "summary": "Architectural memory, symbol index, requirements ledger, and this dashboard." },
    { "id": "platform-foundation",   "label": "Platform & tooling foundation", "kind": "curated",     "flowNodes": [],                      "summary": "The shared substrate every outcome rests on: utilities, CLI tooling, install, and the test suite — and the invariants that keep it sound." }
  ],
