# Required: Your OpenAI API key (needs GPT-5.4 access)
OPENAI_API_KEY=sk-...

# Optional: Override model (default: gpt-5.4)
# OPENAI_AUDIT_MODEL=gpt-5.4

# Optional: Reasoning effort for quality passes (default: high)
# Options: low, medium, high, xhigh
# OPENAI_AUDIT_REASONING=high

# Optional: Hard ceiling for output tokens per pass (default: 32000)
# The adaptive sizing stays below this — only change if you're hitting API limits
# OPENAI_AUDIT_MAX_TOKENS=32000

# Optional: Hard ceiling for timeout per pass in ms (default: 300000 = 5 min)
# OPENAI_AUDIT_TIMEOUT_MS=300000

# Optional: Backend file count threshold for splitting into sub-passes (default: 12)
# If your backend has >12 files referenced in the plan, it auto-splits into routes + services
# OPENAI_AUDIT_SPLIT_THRESHOLD=12

# ── Gemini (Independent Final Reviewer — Step 7) ──────────────────────────

# Optional: Gemini API key for independent final review after Claude-GPT convergence
# If not set, final review falls back to Claude Opus if ANTHROPIC_API_KEY is set
GEMINI_API_KEY=AIza...

# Optional: Override Gemini model (default: gemini-3.1-pro-preview)
# GEMINI_REVIEW_MODEL=gemini-3.1-pro-preview

# Optional: Gemini max output tokens (default: 32000, uses streaming internally)
# GEMINI_REVIEW_MAX_TOKENS=32000

# Optional: Gemini timeout in ms (default: 120000 = 2 min)
# GEMINI_REVIEW_TIMEOUT_MS=120000

# ── Context Brief (auto-generated at audit start) ───────────────────────────

# Optional: Override brief generation model (Gemini Flash → Claude Haiku fallback)
# BRIEF_MODEL_GEMINI=gemini-2.5-flash
# BRIEF_MODEL_CLAUDE=claude-haiku-4-5-20251001

# Optional: Anthropic API key for Claude Haiku brief fallback
# Also used for Step 7 Claude Opus final-review fallback when GEMINI_API_KEY is missing
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Override Claude Opus model for Step 7 fallback
# CLAUDE_FINAL_REVIEW_MODEL=claude-opus-4-1

# Optional: Anthropic backend — how Claude calls are routed.
#   `sdk` (default) — raw @anthropic-ai/sdk; bills your ANTHROPIC_API_KEY
#                     per-token via the standard API meter.
#   `cli`           — spawns `claude -p --output-format json`; calls go
#                     through Claude Code's headless mode.
#
# WARNING — DO NOT set `cli` before 2026-06-15. Until then, every `claude -p`
# invocation drains the same Max subscription pool your interactive IDE
# sessions use, so automated scripts will cannibalise your IDE budget.
# From 2026-06-15 the credit pool splits and `cli` draws from the dedicated
# Max 20x Agent SDK $200/mo credit. Before flipping, install `claude-trace`
# (https://github.com/badlogic/claude-trace) to baseline your token spend
# so you don't trigger overage billing after the credit's $200 cap.
# CLAUDE_BACKEND=sdk

# Optional: Path or alternate name for the `claude` CLI (cli backend only).
# CLAUDE_BIN=claude

# Optional: Per-call subprocess timeout for cli backend (default: 120000ms).
# CLAUDE_CLI_TIMEOUT_MS=120000

# ── Learning Store (cross-session persistence — optional) ─────────────────
#
# Stores debt ledger, audit history, bandit arms, and false-positive patterns
# across sessions and repos. Local JSON files are the no-config default;
# set AUDIT_DB_URL to enable cloud / team learning.
#
# v1 honours AUDIT_DB_URL only — the M4 postgres-parity migration replaced
# the old AUDIT_STORE adapter facade and the SUPABASE_AUDIT_* triplet with
# a single Postgres DSN. Works against any Postgres 13+ (Supabase, self-hosted,
# RDS, Neon, Railway, …) with the pgvector + pg_trgm extensions installed.
#
# For a Supabase project: dashboard → Connect → Session pooler (URI, port 5432).
# AUDIT_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# AUDIT_DB_SSL_MODE=no-verify   # Supabase poolers use an internal CA

# Architectural-memory writes (sb_secret_* per new Supabase key naming).
# Required for `npm run arch:refresh` and `arch:prune`. Reads use the anon key.
# Without this, refresh hard-fails with SERVICE_ROLE_REQUIRED (no anon-write fallback by design).
SUPABASE_AUDIT_SERVICE_ROLE_KEY=

# ── Model A/B/C experiment harness (OpenRouter OSS auditors) ──────────────
# Plan: docs/plans/model-ab-experiment-harness.md (Approved — NOT yet built).
# A funded A/B/C burn-in comparing OSS auditor models vs GPT, via OpenRouter.
#
# Get a key: https://openrouter.ai/keys (free account; pay-per-token — add credits,
# ~€200-400 covers the burn-in). OpenRouter is OpenAI-compatible, so the harness
# drops it in through a baseURL override (the same seam the Azure path uses).
OPENROUTER_API_KEY=sk-or-...

# Optional: OpenRouter endpoint (default shown — only change for a self-hosted proxy).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Hard cumulative spend cap (EUR) for the shadow burn-in — enforced in code once built.
# AUDIT_MODEL_SHADOW_BUDGET_EUR=300

# Arms to shadow (observation-only). LEAVE UNSET until the harness ships — it has NO
# effect before then, and (by design) an unset value is byte-identical to today.
# Once built, e.g.: AUDIT_MODEL_SHADOW=B,C
# AUDIT_MODEL_SHADOW=
