# claude-engineering-skills (CES) .env
# Layout follows docs/reference/env-file-convention.md (claude-engineering-skills):
# numbered sections, one comment line per key, shared keys live in ~/.audit-loop.env.
# Template: copy to .env and fill in. Keys only — never put real values here.

# ══════════════════════════════════════════════════════════════════════
# 1. LLM PROVIDERS
# ══════════════════════════════════════════════════════════════════════

# Anthropic API key (sdk backend; shared — also in ~/.audit-loop.env).
ANTHROPIC_API_KEY=

# OpenAI API key for the GPT auditor (local value wins over ~/.audit-loop.env).
OPENAI_API_KEY=

# Google Gemini API key for the final reviewer (shared).
GEMINI_API_KEY=

# OpenRouter key for the OSS-auditor model experiments (shared).
OPENROUTER_API_KEY=

# xAI key for the native xai final-review shadow arm.
XAI_API_KEY=

# DeepSeek direct-API key for the deepseek shadow arm.
DEEPSEEK_API_KEY=

# Alibaba Cloud workspace key for the qwen shadow arm.
ALIBABA_CLOUD_API_KEY=

# Alibaba Cloud per-account workspace gateway URL (required with the key).
ALIBABA_CLOUD_BASE_URL=

# Claude transport: cli (Max Agent SDK credit) or sdk (API billing).
CLAUDE_BACKEND=

# Pinned GPT auditor model id.
OPENAI_AUDIT_MODEL=

# (carried over from previous .env.example)
# Optional: Reasoning effort for quality passes (default: high)
# Options: low, medium, high, xhigh
# OPENAI_AUDIT_REASONING=high

# (carried over from previous .env.example)
# Optional: Hard ceiling for output tokens per pass (default: 32000)
# The adaptive sizing stays below this — only change if you're hitting API limits
# OPENAI_AUDIT_MAX_TOKENS=32000

# (carried over from previous .env.example)
# Optional: Hard ceiling for timeout per pass in ms (default: 300000 = 5 min)
# OPENAI_AUDIT_TIMEOUT_MS=300000

# (carried over from previous .env.example)
# Optional: Backend file count threshold for splitting into sub-passes (default: 12)
# If your backend has >12 files referenced in the plan, it auto-splits into routes + services
# OPENAI_AUDIT_SPLIT_THRESHOLD=12

# (carried over from previous .env.example)
# Optional: Override Gemini model (default: the `latest-pro` sentinel)
# GEMINI_REVIEW_MODEL=latest-pro

# (carried over from previous .env.example)
# Optional: Gemini max output tokens (default: 32000, uses streaming internally)
# GEMINI_REVIEW_MAX_TOKENS=32000

# (carried over from previous .env.example)
# Optional: Gemini timeout in ms (default: 180000 = 3 min)
# GEMINI_REVIEW_TIMEOUT_MS=180000

# (carried over from previous .env.example)
# Optional: Override brief generation model (Gemini Flash → Claude Haiku fallback)
# BRIEF_MODEL_GEMINI=latest-flash

# (carried over from previous .env.example)
# BRIEF_MODEL_CLAUDE=latest-haiku

# (carried over from previous .env.example)
# Optional: Override Claude Opus model for Step 7 fallback
# CLAUDE_FINAL_REVIEW_MODEL=latest-opus

# (carried over from previous .env.example)
# Optional: Path or alternate name for the `claude` CLI (cli backend only).
# CLAUDE_BIN=claude

# (carried over from previous .env.example)
# Optional: Per-call subprocess timeout for cli backend (default: 120000ms).
# CLAUDE_CLI_TIMEOUT_MS=120000

# (carried over from previous .env.example)
# Optional: OpenRouter endpoint (default shown — only change for a self-hosted proxy).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ══════════════════════════════════════════════════════════════════════
# 2. AZURE WORK PROFILE
# ══════════════════════════════════════════════════════════════════════

# (carried over from previous .env.example)
#
# Run this same bundle against Azure OpenAI + AI Foundry instead of the public
# APIs: GPT auditor → Azure OpenAI, final reviewer → Claude on Foundry,
# embeddings → Azure. Nothing below is set here on purpose — the FULL annotated
# template is a separate file so there is exactly ONE Azure template to keep
# current:
#
#   cp defaults/work-profile.env.example .env      # or ~/.audit-loop.env
#   docs/runbooks/azure-work-profile.md            # setup + rollback guide
#
# THE OPT-IN INVARIANT: the Azure path activates ONLY when AZURE_OPENAI_ENDPOINT
# is set. With no AZURE_* vars, client construction and resolved models are
# byte-identical to the public path (regression-guarded in
# tests/openai-client.test.mjs) — it cannot affect a personal setup.
#
# Two variables catch people out, so they are named here rather than only in the
# guide:
#   AZURE_CLAUDE_ROUTE=apim|foundry — Claude reaches a tenant one of two ways,

# ══════════════════════════════════════════════════════════════════════
# 3. AUDIT STORE / DB
# ══════════════════════════════════════════════════════════════════════

# Audit-store Postgres DSN (Session pooler :5432; shared).
AUDIT_DB_URL=

# TLS mode for the audit store (no-verify for Supabase poolers; shared).
AUDIT_DB_SSL_MODE=

# Generic Postgres DSN.
DATABASE_URL=

# ══════════════════════════════════════════════════════════════════════
# 4. AUDIT-LOOP TOOL
# ══════════════════════════════════════════════════════════════════════

# owner/repo slug matching audit_repos.name (bare name silently misses).
LEARNING_REPO_NAME=

# Extra sibling repo roots swept for solo-control shadow commits.
SOLO_CONTROL_REPO_ROOTS=

# HMAC key for the 2026Q3 final-review campaign (never rotate for an existing campaign).
CAMPAIGN_HMAC_KEY_FINAL_REVIEW_2026Q3=

# HMAC key for the scoped-envelope 2026Q3 campaign.
CAMPAIGN_HMAC_KEY_FINAL_REVIEW_SCOPED_2026Q3=

# ══════════════════════════════════════════════════════════════════════
# 7. FEATURE FLAGS / KILL SWITCHES
# ══════════════════════════════════════════════════════════════════════

# 1 = run the weekly maintenance checks locally from the pre-push hook.
AUDIT_LOOP_WEEKLY_MAINTENANCE=

# (carried over from previous .env.example)
# Hard cumulative spend cap (EUR) for shadow experiments.
# AUDIT_MODEL_SHADOW_BUDGET_EUR=300

# (carried over from previous .env.example)
# Model-A/B/C shadow arms — CONCLUDED experiment (docs/research/experiment-2);
# leave unset. The framework remains for sanctioned re-use only.
# AUDIT_MODEL_SHADOW=

# ══════════════════════════════════════════════════════════════════════
# 8. LOCAL DEV ONLY
# ══════════════════════════════════════════════════════════════════════

# NAS SSH user (infrastructure, not read by code).
SYNOLOGY_USER=

# NAS LAN address (infrastructure, not read by code).
SYNOLOGY_IP=

# NAS SSH port (moved off 22).
SYNOLOGY_PORT=

# NAS SSH password (infrastructure, not read by code).
SYNOLOGY_PASSWORD=

# Cloudflare tunnel token (infrastructure, not read by code).
CLOUDFLARE_TUNNEL_TOKEN=

# ══════════════════════════════════════════════════════════════════════
# 9. UNUSED? (Louis to confirm)
# ══════════════════════════════════════════════════════════════════════
# Moved, not deleted. Nothing in code reads these, or the name looks wrong. Louis decides.

# Old reviewer flag — nothing in CES reads it.
OPENAI_REVIEW_ZONE_RECONFIG=

# Supabase management token — nothing in CES reads it.
SUPABASE_ACCESS_TOKEN=

# BrightData key — nothing in CES reads it.
BRIGHTDATA_API_KEY=

# BrightData SERP zone — nothing in CES reads it.
BRIGHTDATA_SERP_ZONE=

# BrightData web zone — nothing in CES reads it.
BRIGHTDATA_WEB_ZONE=

# Azure Postgres admin user — nothing in CES reads it.
AZURE_PSQL_ADMIN_USERNAME=

# Azure Postgres admin password — nothing in CES reads it.
AZURE_PSQL_ADMIN_PASSWORD=
