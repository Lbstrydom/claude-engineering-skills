# Required: Your OpenAI API key (needs GPT-5.4 access)
OPENAI_API_KEY=sk-...

# Optional: Override model (default: gpt-5.4)
# OPENAI_AUDIT_MODEL=gpt-5.4

# Optional: Reasoning effort for quality passes (default: high)
# Options: low, medium, high, xhigh
# OPENAI_AUDIT_REASONING=high

# Optional: Hard ceiling for output tokens per pass (default: 32000)
# The adaptive sizing stays below this — only change if you're hitting API limits
# OPENAI_AUDIT_MAX_TOKENS=32000

# Optional: Hard ceiling for timeout per pass in ms (default: 300000 = 5 min)
# OPENAI_AUDIT_TIMEOUT_MS=300000

# Optional: Backend file count threshold for splitting into sub-passes (default: 12)
# If your backend has >12 files referenced in the plan, it auto-splits into routes + services
# OPENAI_AUDIT_SPLIT_THRESHOLD=12

# ── Gemini (Independent Final Reviewer — Step 7) ──────────────────────────

# Optional: Gemini API key for independent final review after Claude-GPT convergence
# If not set, final review falls back to Claude Opus if ANTHROPIC_API_KEY is set
GEMINI_API_KEY=AIza...

# Optional: Override Gemini model (default: gemini-3.1-pro-preview)
# GEMINI_REVIEW_MODEL=gemini-3.1-pro-preview

# Optional: Gemini max output tokens (default: 32000, uses streaming internally)
# GEMINI_REVIEW_MAX_TOKENS=32000

# Optional: Gemini timeout in ms (default: 180000 = 3 min)
# GEMINI_REVIEW_TIMEOUT_MS=180000

# ── Context Brief (auto-generated at audit start) ───────────────────────────

# Optional: Override brief generation model (Gemini Flash → Claude Haiku fallback)
# BRIEF_MODEL_GEMINI=gemini-2.5-flash
# BRIEF_MODEL_CLAUDE=claude-haiku-4-5-20251001

# Optional: Anthropic API key for Claude Haiku brief fallback
# Also used for Step 7 Claude Opus final-review fallback when GEMINI_API_KEY is missing
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Override Claude Opus model for Step 7 fallback
# CLAUDE_FINAL_REVIEW_MODEL=claude-opus-4-1

# Optional: Anthropic backend — how Claude calls are routed.
#   `sdk` (default) — raw @anthropic-ai/sdk; bills your ANTHROPIC_API_KEY
#                     per-token via the standard API meter.
#   `cli`           — spawns `claude -p --output-format json`; calls go
#                     through Claude Code's headless mode.
#
# NOTE — `cli` draws from the Max 20x Agent SDK $200/mo credit (non-rolling;
# overage needs manually-enabled billing). Watch the backend's self-reported
# cost_usd on high-volume runs. `sdk` is the safe default for CI and for
# machines without the `claude` CLI installed.
# KNOWN LIMITATION — the cli backend supports single-shot TEXT completions
# only: it silently drops `tools`/`tool_choice`, so any call site needing
# forced tool-calling must construct its client with {backend:'sdk'}
# explicitly (see AGENTS.md "Anthropic Backend Routing").
# CLAUDE_BACKEND=sdk

# Optional: Path or alternate name for the `claude` CLI (cli backend only).
# CLAUDE_BIN=claude

# Optional: Per-call subprocess timeout for cli backend (default: 120000ms).
# CLAUDE_CLI_TIMEOUT_MS=120000

# ── Azure AI Foundry work profile (corporate tenants — optional) ───────────
#
# Run this same bundle against Azure OpenAI + AI Foundry instead of the public
# APIs: GPT auditor → Azure OpenAI, final reviewer → Claude on Foundry,
# embeddings → Azure. Nothing below is set here on purpose — the FULL annotated
# template is a separate file so there is exactly ONE Azure template to keep
# current:
#
#   cp defaults/work-profile.env.example .env      # or ~/.audit-loop.env
#   docs/runbooks/azure-work-profile.md            # setup + rollback guide
#
# THE OPT-IN INVARIANT: the Azure path activates ONLY when AZURE_OPENAI_ENDPOINT
# is set. With no AZURE_* vars, client construction and resolved models are
# byte-identical to the public path (regression-guarded in
# tests/openai-client.test.mjs) — it cannot affect a personal setup.
#
# Two variables catch people out, so they are named here rather than only in the
# guide:
#   AZURE_CLAUDE_ROUTE=apim|foundry — Claude reaches a tenant one of two ways,
#     and they are DIFFERENT SERVICES (different host, credential and auth
#     header). Set it to `apim` if your tenant fronts Foundry with API
#     Management, even when AZURE_AI_ENDPOINT is also set.
#   AZURE_AI_API_KEY — the DIRECT Foundry key, when it differs from
#     AZURE_OPENAI_API_KEY (it usually does behind a gateway).
#
# Check what you have configured without printing a single secret:
#   npm run azure:routes

# ── Learning Store (cross-session persistence — optional) ─────────────────
#
# Stores debt ledger, audit history, bandit arms, and false-positive patterns
# across sessions and repos. Local JSON files are the no-config default;
# set AUDIT_DB_URL to enable cloud / team learning.
#
# v1 honours AUDIT_DB_URL only — the M4 postgres-parity migration replaced
# the old AUDIT_STORE adapter facade and the SUPABASE_AUDIT_* triplet with
# a single Postgres DSN. Works against any Postgres 13+ (Supabase, self-hosted,
# RDS, Neon, Railway, …) with the pgvector + pg_trgm extensions installed.
#
# For a Supabase project: dashboard → Connect → Session pooler (URI, port 5432).
# AUDIT_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# AUDIT_DB_SSL_MODE=no-verify   # Supabase poolers use an internal CA
#
# For a plain/self-hosted Postgres (localhost, Docker, RDS, Neon, ...):
# AUDIT_DB_URL=postgresql://postgres:<password>@localhost:5432/audit_loop
# AUDIT_DB_SSL_MODE=disable     # localhost without TLS; use `require` for TLS hosts
# Then bootstrap once: node scripts/setup-postgres.mjs --migrate
# (needs the pgvector extension installed on the server + a role with
#  CREATEROLE — see docs/runbooks/postgres-parity.md)
#
# The AUDIT_DB_URL DSN is the ONLY database secret — arch-memory
# (`npm run arch:refresh`) and all other cloud features use it too. The
# legacy SUPABASE_AUDIT_* triplet is sunset (M4 postgres-parity); setting
# any of those without AUDIT_DB_URL now fails fast with a migration hint.

# ── OpenRouter (OSS models — optional) ─────────────────────────────────────
# Used by the tiered-recall pipeline's GLM discovery/triage stages and the
# model-eval harness's OSS candidates. Fully optional: absent → the default
# legacy audit path is unaffected, and tiered-pipeline stages fall back with
# a loudly-named reason (never a silent skip).
#
# Get a key: https://openrouter.ai/keys (free account; pay-per-token).
# OpenRouter is OpenAI-compatible — wired through a baseURL override on the
# same client seam the Azure path uses.
# OPENROUTER_API_KEY=sk-or-...

# Optional: OpenRouter endpoint (default shown — only change for a self-hosted proxy).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Hard cumulative spend cap (EUR) for shadow experiments.
# AUDIT_MODEL_SHADOW_BUDGET_EUR=300

# Model-A/B/C shadow arms — CONCLUDED experiment (docs/research/experiment-2);
# leave unset. The framework remains for sanctioned re-use only.
# AUDIT_MODEL_SHADOW=
