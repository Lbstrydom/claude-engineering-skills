@@ -232,6 +232,105 @@ export function gitDiffWithWorkingTree(cwd, sinceCommit) {
  * @param {string} filePath - repo-relative path, forward-slash form
  * @returns {{ok: true, content: string} | {ok: false, error: VcsError}}
