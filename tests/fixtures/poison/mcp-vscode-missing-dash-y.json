{
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--headless"
      ]
    },
    "mermaid": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-mermaid@latest"
      ]
    }
  }
}
