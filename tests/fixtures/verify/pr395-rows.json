     }
    },
    {
     "id": "H2",
     "severity": "HIGH",
     "category": "[be-services] Incorrect reconciliation",
     "section": "scripts/lib/fleet/rollup-land.mjs: closeBoundToHead before-state handling",
     "detail": "The new `before.state.toUpperCase() !== 'OPEN'` branch returns `closed` before comparing the head. For example, if the head moves around a close and the post-close read reports `failed`, the next resume sees the closed PR and records success even though its head still contains unlanded commits. The same loss of evidence occurs if the process crashes after the close.",
     "_hash": "342f6d6f",
     "_pass": "be-services",
     "_sourceModel": "gpt-6.1-terra",
     "_primaryFile": "scripts/lib/fleet/rollup-land.mjs",
