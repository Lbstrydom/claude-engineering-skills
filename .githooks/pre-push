#!/bin/bash
# Pre-push hook for claude-engineering-skills.
#
# -1. SELF-HEAL — corrects core.bare if a concurrent session left it wrongly
#     true (see §-1 below for the incident this traces to).
# 0. RANGE  — reads git's stdin ONCE and derives the commit range being pushed.
# 1. CHECKS — runs `npm run check` against a CLEAN CHECKOUT of the pushed
#    commit (a throwaway git worktree), NOT the working tree. BLOCKS on
#    failure. Bypass when you must: git push --no-verify
#    A push of ONLY refs/heads/archive/* or refs/tags/archive/* takes the archive
#    lane instead (section 0.97): a scan of what it publishes, not the full check.
# 2. SYNC   — propagates SKILL.md + scripts to consumer repos. Non-blocking:
#    a missing consumer repo warns but never stops the push.
#
# WHY THE SANDBOX (2026-07-20): we routinely run two agent sessions against one
# working tree. Checking the tree meant session A's push was blocked by session
# B's half-finished edits (false block → the gate gets --no-verify'd → it is
# effectively disarmed), AND a fix present in the tree but absent from the
# commit made the hook green while the pushed commit was broken (false pass).
# A clean checkout of the pushed sha verifies exactly what the remote receives.
# Deliberately NOT `git stash`: with two live sessions that yanks the other
# session's files mid-edit, and a pop conflict wedges both.
# Set AUDIT_PREPUSH_SANDBOX=0 to run the checks in-tree (old behaviour).
#
# TRACKED — this file is the source of truth, wired via core.hooksPath=.githooks
# by `scripts/install-git-hooks.mjs` on `npm install` (the `prepare` lifecycle).
# It used to live untracked in .git/hooks/, installed by nothing: a fresh clone
# had NO gates at all, while AGENTS.md cited "the pre-push hook" as established.
# `npm run check` is this repo's only gate — no workflow runs it on push or PR
# (npm test runs solely in release.yml, on a version tag) — so an uninstallable
# hook meant an unenforced repo. Edit here, never in .git/hooks/.
#
# FAIL CLOSED WHEN KILLED (2026-10-12): Git for Windows reads a hook's exit code
# as `code & 0xff`, and an MSYS bash killed by signal S exits `S << 8` — so a
# killed hook reads as exit 0 and the push went through. The two marked blocks
# below trap every catchable terminating signal (L1) and leave a record that the
# NEXT push reports if this hook died untrappably (L3).
# docs/runbooks/prepush-sandbox.md §8.

# >>> fail-closed-on-signal >>>
prepush_killed() {
  trap '' $PREPUSH_TRAPPED
  echo "✗  pre-push hook interrupted by SIG$1 — push BLOCKED (a killed gate is not a pass)." >&2
  exit 1
}
# Every POSIX terminating signal, unconditionally; then the XSI ones this shell knows
# (`kill -l NAME` fails on an unknown name, so an exotic sh never errors on `trap`).
PREPUSH_TRAPPED=""
for prepush_sig in HUP INT QUIT ABRT ALRM TERM PIPE USR1 USR2 TRAP BUS FPE ILL SEGV SYS XCPU XFSZ VTALRM PROF; do
  case "$prepush_sig" in
    TRAP|BUS|FPE|ILL|SEGV|SYS|XCPU|XFSZ|VTALRM|PROF) kill -l "$prepush_sig" >/dev/null 2>&1 || continue ;;
  esac
  trap "prepush_killed $prepush_sig" "$prepush_sig"
  PREPUSH_TRAPPED="$PREPUSH_TRAPPED $prepush_sig"
done
# <<< fail-closed-on-signal <<<

# >>> prepush-inflight-record (see docs/runbooks/prepush-sandbox.md §8) >>>
PREPUSH_INFLIGHT_REC=""
prepush_inflight_write() {   # $1 = the gated sha, or "pending" before the range is known
  [ -n "$PREPUSH_INFLIGHT_REC" ] || return 0
  printf '%s %s %s %s\n' "$$" "$1" "$PREPUSH_STARTED" "${PREPUSH_REMOTE:--}" \
    2>/dev/null > "$PREPUSH_INFLIGHT_REC.tmp" && mv -f "$PREPUSH_INFLIGHT_REC.tmp" "$PREPUSH_INFLIGHT_REC" 2>/dev/null
}
PREPUSH_REMOTE="$1"
PREPUSH_STARTED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
PREPUSH_COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
case "$?:$PREPUSH_COMMON_DIR" in
  0:/*|0:[A-Za-z]:/*) PREPUSH_INFLIGHT_DIR="$PREPUSH_COMMON_DIR/prepush-inflight" ;;
  *) PREPUSH_INFLIGHT_DIR="" ;;   # unresolved: no record, no reconciliation — never a fallback path
esac
if [ -n "$PREPUSH_INFLIGHT_DIR" ] && mkdir -p "$PREPUSH_INFLIGHT_DIR" 2>/dev/null; then
  for rec in "$PREPUSH_INFLIGHT_DIR"/*.rec; do
    [ -f "$rec" ] || continue
    read -r rec_pid rec_sha rec_started rec_remote 2>/dev/null < "$rec"   # stderr first: a concurrent rm is silent
    case "$rec_pid" in ''|*[!0-9]*) rm -f "$rec"; continue ;; esac
    # Alive = a concurrent push: leave it. Never OUR pid, though: this hook has written
    # nothing yet, so a record named for $$ is a dead predecessor whose pid was reused —
    # treating it as alive would let the write below overwrite the evidence.
    [ "$rec_pid" != "$$" ] && kill -0 "$rec_pid" 2>/dev/null && continue
    echo "⚠ an earlier pre-push (pid $rec_pid, remote $rec_remote, started $rec_started) was KILLED before it" >&2
    echo "  finished. Git for Windows reads a killed hook as a PASS, so if that push reached the remote it went UNGATED." >&2
    case "$rec_sha" in ''|*[!0-9a-f]*) rec_sha="" ;; esac   # "pending", "unresolved", garbage
    [ "${#rec_sha}" -ge 7 ] || rec_sha=""
    if [ -n "$rec_sha" ]; then
      echo "  It was gating $rec_sha. Check: git branch -r --contains $rec_sha   (runbook §8)" >&2
    else
      echo "  It died before the gated commit was known. Find what it pushed: runbook §8 'unknown commit'." >&2
    fi
    rm -f "$rec"
  done
  PREPUSH_INFLIGHT_REC="$PREPUSH_INFLIGHT_DIR/$$.rec"
  trap 'rm -f "$PREPUSH_INFLIGHT_REC" "$PREPUSH_INFLIGHT_REC.tmp"' EXIT   # BEFORE the first write
  prepush_inflight_write pending
fi
# <<< prepush-inflight-record <<<

# ── -1. Self-heal a corrupted core.bare (2026-07-23 incident) ────────────
# Traced live: `core.bare` was repeatedly found flipped to `true` on this
# checkout with no corresponding commit — root-caused to ACTIVITY IN A
# CONCURRENT SESSION sharing the same .git/config (15+ claude.exe processes
# were confirmed running simultaneously at the time; nothing in this repo's
# own tooling ever sets core.bare — grepped clean, scripts/**/*.mjs has zero
# hits). When bare, every git operation that needs a working tree fails with
# "fatal: this operation must be run in a work tree" — including the
# `git rev-parse --show-toplevel` two lines below, which would otherwise
# silently resolve REPO_ROOT to empty and skip every check in this hook
# WITHOUT printing an error (a worse failure than the loud one this causes
# downstream). Detect + correct it here, first, before anything depends on a
# working tree existing.
#
# Safety: only correct bare=true when a real checked-out tree is actually
# here (package.json at cwd — hooks run with cwd at the worktree root, and a
# plain `[ -f ]` filesystem check doesn't care about git's bare/non-bare
# interpretation, so this reads correctly even while core.bare is wrong). A
# genuinely bare repo has no checked-out files at all, so this can never
# misfire on one.
#
# Known limit: this only catches the flag being wrong AT HOOK START. It was
# also observed flipping again mid-run, partway through the ~30s sandboxed
# `npm run check` (a different, harder problem — guarding every downstream
# git call individually against a concurrent external writer is out of scope
# here; retry after a `git push --no-verify` / manual `git config core.bare
# false` if that happens).
if [ -f "package.json" ] && [ "$(git config --get core.bare 2>/dev/null)" = "true" ]; then
  echo "⚠ core.bare was incorrectly true (see .githooks/pre-push §-1) — corrected to false." >&2
  git config core.bare false
fi

# ── The mid-run flip (2026-07-23) — FIXED, but not by an env var ──────────
# The self-heal above only catches the flag being wrong AT HOOK START — it
# was ALSO observed flipping again mid-run, partway through the ~30s
# sandboxed `npm run check`, which is where the actual damage happens (100+
# spurious git-related test failures per occurrence). Root cause: a
# concurrent process sharing this checkout's .git/config — most likely
# another Claude Code session's own worktree/git activity racing on the same
# .git/config.lock. This is a NAMED, documented bug class, not a mystery:
# anthropics/claude-code issues #34645 and #55724 describe the identical
# mechanism (parallel `Agent(isolation:"worktree")` calls racing on
# .git/config.lock and .git/index.lock), both closed unfixed. Two concurrent
# SESSIONS each running their own sandboxed pre-push (this exact mechanism)
# reproduces the same race without needing the Agent tool at all.
#
# Two env-based overrides were investigated and REJECTED, both by live
# testing, not reasoning about git internals:
#
#   - GIT_CONFIG_COUNT/GIT_CONFIG_KEY_0/GIT_CONFIG_VALUE_0 (independently
#     suggested by GPT-5.6 + Gemini 3 Pro via /brainstorm): does NOT work for
#     core.bare specifically — it's resolved during repository discovery,
#     before config-layering (which env overrides participate in) even
#     applies. Confirmed the mechanism itself is fine for ordinary keys
#     (user.name); core.bare is the exception.
#   - GIT_WORK_TREE (global export, then scoped to just the sandbox's
#     spawnSync env): DOES bypass a corrupted core.bare, but is a
#     process-tree-wide override with no per-command scoping — exported
#     globally it overrides `cd` for every descendant (would have made the
#     sandbox's clean-checkout guarantee fake); scoped to just the sandbox it
#     still broke our OWN tests that spawn independent throwaway git repos as
#     fixtures (they inherit the same env var; git refuses their calls
#     without a matching GIT_DIR).
#
# What actually works, live-tested end-to-end (corrupted the shared common
# config WHILE the sandboxed run was in flight; 8466/8466 pass, matching the
# clean baseline): `git config --worktree core.bare false`, git's PER-WORKTREE
# config file (requires extensions.worktreeConfig, already enabled on this
# repo — apparently by the harness itself when provisioning worktrees; see
# git-worktree(1) "CONFIGURATION FILE"). Unlike an env var, config.worktree is
# a file scoped to ONE worktree's .git/worktrees/<name>/ — it cannot leak
# into a nested `git init`'s own unrelated .git directory the way an
# inherited environment variable can (verified live: a throwaway repo created
# INSIDE a protected sandbox is completely unaffected by the sandbox's own
# override). Applied to the sandbox in scripts/prepush-check.mjs right after
# `git worktree add`, and standing on both this checkout and the linked
# worktree as a persistent hardening measure.
#
# A SIBLING symptom of the same root cause (2026-07-23, same investigation):
# not every collision is a corrupted VALUE — some are a transient LOCK held
# by the peer session for a few hundred ms (git aborts immediately with
# "could not lock config file: File exists" / "Unable to create
# '.../index.lock'"). Retrying doesn't help a corrupted value (the bad value
# is durably on disk until something resets it — the worktree-scoped pin
# above is the fix for that), but it's the standard, correct mitigation for a
# lock that's about to be released. scripts/prepush-check.mjs now wraps
# `git worktree add/remove/prune` — the calls in this hook's own sandbox that
# touch the shared .git/config and .git/worktrees/ metadata — in
# exponential-backoff retry (200/400/800ms, `withGitLockRetry`), matching
# git's own documented advice for its advisory locks. This does not need
# duplicating here: the hook only ever calls into prepush-check.mjs for the
# worktree lifecycle, never `git worktree` directly.

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
ZERO_SHA="0000000000000000000000000000000000000000"

# ── 0. Push range (read stdin ONCE) ──────────────────────────────────────
# git feeds `<local_ref> <local_sha> <remote_ref> <remote_sha>` per line. stdin
# is a stream: whoever reads it first consumes it. This block is the ONLY
# reader — everything downstream uses the captured copy. (Before 2026-07-20 the
# DB-seam advisory consumed it directly; adding a second reader silently
# starved one of them.)
PUSH_STDIN=""
if [ ! -t 0 ]; then
  PUSH_STDIN="$(cat)"
fi

PUSH_BASE=""
PUSH_HEAD=""
PUBLISHED_REFS=0   # ref updates that send commits — anything but a deletion
DELETED_REFS=0
# Does this push update the DEFAULT branch? Only then may it publish to consumers (step 2).
DEFAULT_BRANCH="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"
DEFAULT_BRANCH="${DEFAULT_BRANCH#origin/}"
[ -z "$DEFAULT_BRANCH" ] && DEFAULT_BRANCH="main"
PUSHES_DEFAULT=0
DEFAULT_PUSH_SHA=""
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ -z "$LOCAL_SHA" ] && continue
  if [ "$LOCAL_SHA" = "$ZERO_SHA" ]; then
    DELETED_REFS=$((DELETED_REFS + 1))   # branch deletion — nothing pushed
    continue
  fi
  PUBLISHED_REFS=$((PUBLISHED_REFS + 1))
  if [ "$REMOTE_REF" = "refs/heads/$DEFAULT_BRANCH" ]; then PUSHES_DEFAULT=1; DEFAULT_PUSH_SHA="$LOCAL_SHA"; fi
  [ -n "$PUSH_BASE" ] && continue   # range already taken from an earlier ref
  if [ -z "$REMOTE_SHA" ] || [ "$REMOTE_SHA" = "$ZERO_SHA" ]; then
    # New branch on the remote: the range is everything since it diverged from
    # the default branch. NOT HEAD~1 — that would scope a multi-commit branch
    # to its tip and let violations in earlier commits through.
    CANDIDATE_BASE=$(git merge-base origin/main "$LOCAL_SHA" 2>/dev/null)
  else
    CANDIDATE_BASE="$REMOTE_SHA"
  fi
  if [ -n "$CANDIDATE_BASE" ]; then
    # First pushed ref wins; a multi-ref push is checked at its first ref. No
    # `break` — the loop must see every line to count the deletions below.
    PUSH_BASE="$CANDIDATE_BASE"
    PUSH_HEAD="$LOCAL_SHA"
  fi
done <<EOF
$PUSH_STDIN
EOF
prepush_inflight_write "${PUSH_HEAD:-unresolved}"   # L3: the gated sha is known from here on

# ── 0.5 Delete-only push: nothing published, nothing to check ────────────
# A push whose EVERY ref update is a deletion sends no commits, so there is no
# artifact for `npm run check` to verify. Before 2026-10-02 it ran anyway with
# an empty range: in a worktree detached at origin/main the drift gates'
# fork-point inference resolved to HEAD itself, and after ~10 minutes
# status:integrity:gate failed closed on `base == HEAD` and blocked
# `git push origin --delete <branch>`. Both conjuncts are load-bearing:
# DELETED_REFS > 0 keeps empty stdin (no push info at all — a tty, a manual
# run) from skipping vacuously, and PUBLISHED_REFS == 0 keeps a mixed push
# checked at its real update. Exits before sync/maintenance too: a deletion
# changes nothing they act on, and both re-run on the next real push.
if [ "$PUBLISHED_REFS" -eq 0 ] && [ "$DELETED_REFS" -gt 0 ]; then
  echo "→ pre-push: delete-only push ($DELETED_REFS ref(s)) publishes no commits — checks skipped." >&2
  exit 0
fi

# ── 0.9 Working-tree-only checks (blocking) ─────────────────────────────
# Checks whose subject is UNTRACKED working-tree debris cannot run in the
# sandbox: a clean checkout has no untracked files, so they would find nothing
# and report a green they did not earn. They run here, against the real tree,
# BEFORE the sandbox. Keep this list minimal — anything that can be judged from
# committed source belongs in `npm run check`, where it gets the clean-checkout
# guarantee. Nothing else has qualified so far; add only with the same argument.
if [ -f "$REPO_ROOT/package.json" ]; then
  ( cd "$REPO_ROOT" && node scripts/check-stale-skill-surface.mjs --gate )
  WT_EXIT=$?
  if [ $WT_EXIT -ne 0 ]; then
    echo "✗  working-tree checks FAILED (exit $WT_EXIT) — push blocked."
    echo "   A stale .github/skills/ tree shadows .claude/skills/ for Copilot."
    echo "   Fix the issues above, or bypass with: git push --no-verify"
    exit 1
  fi
fi

# ── 0.95 Harvest audit transcripts from linked worktrees (NON-blocking) ──
# `.audit/` is gitignored, so a transcript written inside a throwaway worktree
# is deleted with that worktree. The mirror-at-write in
# lib/audit/transcript-archive.mjs covers everything written from now on; this
# sweep is the backstop for worktrees that predate it and for the orphan case
# (a failed `git worktree remove` deregisters but leaves the directory, so no
# git-based scan can see it). Plan: docs/plans/audit-transcript-durability.md.
#
# Runs HERE and not in `npm run check` for the same reason as §0.9, inverted:
# the sandbox is a clean checkout with no `.claude/worktrees/` at all, so the
# sweep there would report green having examined nothing. It is also a
# side-effecting maintenance action, not a gate — hence non-blocking.
if [ -f "$REPO_ROOT/package.json" ]; then
  ( cd "$REPO_ROOT" && node scripts/harvest-audit-transcripts.mjs --quiet ) || \
    echo "⚠ transcript harvest failed (non-blocking) — see docs/plans/audit-transcript-durability.md" >&2
fi

# ── 0.97 Archive lane (blocking) ─────────────────────────────────────────
# A push whose EVERY ref lands under refs/heads/archive/ or refs/tags/archive/ is a
# backup of work in flight. `npm run check` fails on such a commit for reasons that
# say nothing about publishing it (docs-ref drift, a stale generated index, a
# live-store gate), and the pusher then reaches for `git push --no-verify`, which
# disarms every gate. The lane replaces that habit with the one check that matters
# when commits become public: a scan of EXACTLY what this push publishes, for
# secret-shaped content and sensitive paths. `check` has no such scan, so this is
# added, not kept. Plan + evidence: docs/plans/prepush-archive-lane.md.
#
# The lane predicate lives in ONE place, scripts/prepush-archive-lane.mjs; this block
# never re-derives it. The CLI prints a single `archive-lane/v1 <outcome>` line and
# the hook acts on that token alone, never on exit status (node exits 1 on a syntax
# error before any catch can run):
#   not-applicable  → fall through to the full gate, silently
#   clean           → skip the full check
#   findings|error  → block (an eligible push that could not be scanned is refused)
#   no valid token  → a push that LOOKS archive-only is refused (the full gate does not scan);
#                     any other push warns loudly and runs the full gate
# A `not-applicable` token for a push that nonetheless looks archive-only means the lane and
# this hook disagree about the push; that is refused too, for the same reason.
#
# The lane's code comes from the checkout THIS HOOK lives in ($0), NOT from the
# pusher's cwd. core.hooksPath points at one checkout's .githooks while pushes come
# from any worktree (measured: it pointed into a linked worktree, in backslash form),
# so REPO_ROOT/scripts may predate the lane while the hook is new. `\` is normalised
# first: dirname on a backslash path returns "." and would resolve the PARENT of cwd.
# AUDIT_PREPUSH_ARCHIVE_LANE=0 reverts to the full gate — a loosening, since the full
# gate does not scan; it exists so a lane bug is never an outage.
# Does this push LOOK archive-only? The one place bash spells the archive predicate
# (scripts/lib/prepush-archive-lane.mjs isArchiveRef is the oracle). It can only ever
# BLOCK, never choose the lane, and a drift test compares it with the oracle ref by ref
# (tests/prepush-archive-lane-hook.test.mjs). Returns 0 = every destination is an archive
# ref, 1 = not, 2 = could not tell. Fields are counted FROM THE RIGHT (`$(NF-1)` is the
# remote ref): the local field is a revision expression and may hold spaces. awk over the
# captured copy, not a second `while read`: the stdin-once invariant
# (tests/prepush-sandbox-honesty.test.mjs) allows ONE loop, the range loop above.
lane_looks_archive() {
  local seen other
  seen="$(printf '%s\n' "$PUSH_STDIN" | awk 'NF >= 4 && $(NF-1) ~ /^refs\/(heads|tags)\/archive\/./ { n++ } END { print n + 0 }')" || return 2
  other="$(printf '%s\n' "$PUSH_STDIN" | awk 'NF >= 4 && $(NF-1) !~ /^refs\/(heads|tags)\/archive\/./ { n++ } END { print n + 0 }')" || return 2
  case "$seen" in ''|*[!0-9]*) return 2 ;; esac
  case "$other" in ''|*[!0-9]*) return 2 ;; esac
  [ "$other" -eq 0 ] && [ "$seen" -gt 0 ] && return 0
  return 1
}

LANE_HANDLED=0
if [ "$AUDIT_PREPUSH_ARCHIVE_LANE" != "0" ] && [ "$PUBLISHED_REFS" -gt 0 ]; then
  # Plain path arithmetic, deliberately NOT `git -C "$HOOK_DIR" rev-parse`: git exports
  # GIT_DIR into a hook's environment, which overrides discovery and would answer with
  # the PUSHER's checkout — the exact thing this block must not use. `pwd -W` gives a
  # Windows-form path under Git Bash (falling back to plain `pwd` elsewhere).
  HOOK_DIR="$(dirname "${0//\\//}")"
  # CDPATH= and `--`: with CDPATH set, `cd` PRINTS the directory it resolved, which would
  # corrupt HOOK_ROOT and make a healthy lane look "not found".
  HOOK_ROOT="$(CDPATH= cd -- "$HOOK_DIR/.." >/dev/null 2>&1 && { pwd -W 2>/dev/null || pwd; })"
  LANE_SCRIPT="$HOOK_ROOT/scripts/prepush-archive-lane.mjs"
  if [ -n "$HOOK_ROOT" ] && [ -f "$LANE_SCRIPT" ]; then
    LANE_OUT="$(printf '%s\n' "$PUSH_STDIN" | ( cd "$REPO_ROOT" && node "$LANE_SCRIPT" --remote="$1" --destination="$2" ))"
    LANE_TOKEN="$(printf '%s\n' "$LANE_OUT" | grep -E '^archive-lane/v1 (not-applicable|clean|findings|error)$' | tail -n 1)"
  else
    LANE_TOKEN=""
    LANE_WHY="its script was not found next to this hook"
  fi
  case "$LANE_TOKEN" in
    "archive-lane/v1 clean")
      LANE_HANDLED=1
      echo "✓  archive lane clean — the full check was skipped (docs-ref drift, generated-artifact freshness, the suite do not apply to a backup ref)."
      ;;
    "archive-lane/v1 findings"|"archive-lane/v1 error")
      echo "✗  pre-push archive lane blocked this push — the details are above."
      exit 1
      ;;
    "archive-lane/v1 not-applicable")
      # The lane says this is not an archive push. If this hook positively reads it as one,
      # they disagree about the same bytes, and the full gate (which does not scan) would
      # publish it unscanned. Refuse. (Could-not-tell, rc 2, trusts the lane: it was positive.)
      lane_looks_archive
      if [ $? -eq 0 ]; then
        echo "✗  archive lane and pre-push hook disagree about this push (the lane says not-applicable, the hook reads it as archive-only): refusing, because the full gate does NOT scan published content." >&2
        echo "   Force the full gate on purpose: AUDIT_PREPUSH_ARCHIVE_LANE=0 git push" >&2
        exit 1
      fi
      ;;
    *)
      # No valid result (script missing, crash, wrong protocol). Without the lane the
      # hook cannot know a push was archive-only, so for an ordinary push this falls
      # to the full gate as before. But for a push that LOOKS archive-only, or that cannot
      # be classified, the full gate is the wrong answer: it fails on a backup for
      # unrelated reasons AND does not scan, so it would either wave the push through
      # unscanned or push the user to --no-verify. Only a positive "not archive" proceeds.
      lane_looks_archive
      if [ $? -ne 1 ]; then
        echo "✗  archive lane unavailable (${LANE_WHY:-it produced no valid result}) for a push that looks archive-only or cannot be classified: refusing, because the full gate does NOT scan published content." >&2
        echo "   Fix the lane, or revert to the full gate on purpose: AUDIT_PREPUSH_ARCHIVE_LANE=0 git push" >&2
        exit 1
      fi
      echo "⚠ archive lane unavailable (${LANE_WHY:-it produced no valid result}): running the full gate, which does NOT scan published content." >&2
      ;;
  esac
fi

# ── 1. Checks (blocking) ────────────────────────────────────────────────
if [ "$LANE_HANDLED" -ne 1 ] && [ -f "$REPO_ROOT/package.json" ]; then
  if [ "$AUDIT_PREPUSH_SANDBOX" = "0" ]; then
    echo "→ Pre-push checks: npm run check (in-tree; sandbox disabled) ..."
    ( cd "$REPO_ROOT" && AUDIT_PUSH_RANGE_BASE="$PUSH_BASE" AUDIT_PUSH_RANGE_HEAD="$PUSH_HEAD" npm run check )
    CHECK_EXIT=$?
  else
    ARGS=()
    [ -n "$PUSH_BASE" ] && ARGS+=(--base "$PUSH_BASE")
    [ -n "$PUSH_HEAD" ] && ARGS+=(--head "$PUSH_HEAD")
    # The test tier (docs/plans/gate-cost-slice-2.md): AUDIT_PREPUSH_TIER=branch opts a work-in-progress push into
    # skipping the unreached heavy files; unset (the default) is the FULL suite plus a shadow line. A push to the
    # default branch is always full (the sandbox decides from --pushes-default). The sandbox writes ONE summary line
    # to a file this hook owns and removes; the success label below is read from it, never assumed.
    TIER_SUMMARY_FILE="$(mktemp 2>/dev/null)"
    TIER_SUMMARY_ARG="$TIER_SUMMARY_FILE"
    if [ -n "$TIER_SUMMARY_FILE" ] && command -v cygpath >/dev/null 2>&1; then TIER_SUMMARY_ARG="$(cygpath -w "$TIER_SUMMARY_FILE")"; fi
    [ -n "$TIER_SUMMARY_FILE" ] && ARGS+=(--summary-file "$TIER_SUMMARY_ARG")
    [ -n "${AUDIT_PREPUSH_TIER:-}" ] && ARGS+=(--tier "$AUDIT_PREPUSH_TIER")
    [ "$PUSHES_DEFAULT" = "1" ] && ARGS+=(--pushes-default)
    ( cd "$REPO_ROOT" && node scripts/prepush-check.mjs "${ARGS[@]}" )
    CHECK_EXIT=$?
  fi
  if [ $CHECK_EXIT -ne 0 ]; then
    [ -n "${TIER_SUMMARY_FILE:-}" ] && rm -f "$TIER_SUMMARY_FILE"
    echo "✗  pre-push checks FAILED (exit $CHECK_EXIT) — push blocked."
    echo "   Fix the issues above, or bypass with: git push --no-verify"
    exit 1
  fi
  # The label is what the checks REPORTED for the pushed head: exactly one line in the test-tier/v1 grammar naming
  # PUSH_HEAD. Anything else (missing, truncated, malformed, duplicated, another sha) is said as "tier NOT reported"
  # and is never read as full or branch, so nothing here can pass for a full verdict (audit M1).
# >>> tier-label (the success label is read from the sandbox's summary; tests/pre-push-tier-label.test.mjs runs this block)
  TIER_LABEL=""
  if [ "$AUDIT_PREPUSH_SANDBOX" = "0" ]; then
    TIER_LABEL=" (full, in-tree)"
  else
    TIER_RE='^test-tier/v1 (full|branch) ([0-9a-f]{40,64}) skipped=([0-9]+) base=([0-9a-f]{40,64}|none)( reason=[A-Za-z0-9._:-]+)?$'
    TIER_WHY="no summary file"
    if [ -n "${TIER_SUMMARY_FILE:-}" ] && [ -s "$TIER_SUMMARY_FILE" ]; then
      TIER_LINES=$(grep -c . "$TIER_SUMMARY_FILE")
      TIER_LINE=$(grep . "$TIER_SUMMARY_FILE" | head -n 1 | tr -d '\015')
      if [ "$TIER_LINES" != "1" ]; then TIER_WHY="the summary has $TIER_LINES lines"
      elif ! [[ "$TIER_LINE" =~ $TIER_RE ]]; then TIER_WHY="the summary is malformed"
      elif [ -n "$PUSH_HEAD" ] && [ "${BASH_REMATCH[2]}" != "$PUSH_HEAD" ]; then TIER_WHY="the summary names another commit"
      elif [ "${BASH_REMATCH[1]}" = "branch" ]; then TIER_LABEL=" (branch tier: ${BASH_REMATCH[3]} heavy files skipped - NOT the full suite)"; TIER_WHY=""
      else TIER_LABEL=" (full)"; TIER_WHY=""
      fi
    fi
    [ -n "$TIER_WHY" ] && TIER_LABEL=" (tier NOT reported: $TIER_WHY)"
  fi
# <<< tier-label <<<
  [ -n "${TIER_SUMMARY_FILE:-}" ] && rm -f "$TIER_SUMMARY_FILE"
  echo "✓  checks passed${TIER_LABEL}"
fi

# ── 1.5 Remote-gate observability (non-blocking) ─────────────────────────
# A local gate cannot be ignored — it blocks the push. A REMOTE gate can stay
# red indefinitely while everyone assumes it is green, which is exactly what
# happened: postgres-parity failed 20 consecutive runs over two days
# (2026-07-18 → 07-20) and nothing surfaced it. Worse, the advisory that used
# to live here pointed AT that job as the DB seam's coverage story, so the
# local side deferred to CI while CI deferred to nobody.
#
# This block is the local-first principle applied to OBSERVING CI rather than
# replacing it: surface a red remote gate at the one moment the operator is
# guaranteed to be looking. Never blocks — a red CI run is information about
# an ALREADY-pushed commit, not a verdict on this one.
#
# (The DB-seam advisory this replaces is obsolete: `npm run check` now runs the
# destructive suites via db:suites:gate, so the claim that it does not was
# false the moment that landed.)
{
  if command -v gh >/dev/null 2>&1; then
    # full-suite.yml is the full test run that merge rule 8 reads (docs/plans/ci-full-suite-actions.md); a red main there
    # means the landed sha failed the suite that a light local push no longer runs.
    for CI_WORKFLOW in postgres-parity.yml full-suite.yml; do
      # --limit 1 on the default branch; the JSON form avoids scraping columns.
      LAST_CI=$(gh run list --workflow="$CI_WORKFLOW" --branch main --limit 1 \
                  --json conclusion,status -q '.[0] | "\(.status):\(.conclusion // "")"' 2>/dev/null)
      case "$LAST_CI" in
        completed:failure|completed:timed_out|completed:startup_failure)
          echo "⚠ ${CI_WORKFLOW%.yml} on main is RED (last run: ${LAST_CI#completed:}) — the remote gate is not passing." >&2
          echo "  Inspect: gh run list --workflow=$CI_WORKFLOW --limit 5" >&2
          ;;
        # Any other value (success, in_progress, empty, gh unauthenticated) is
        # deliberately silent. This block reports a KNOWN-red gate; it must never
        # imply the gate is green, and it must never nag on a transient state.
        *) : ;;
      esac
    done
  fi
} || true

# ── 2. Consumer-repo sync (non-blocking) ────────────────────────────────
# Consumers receive the DEFAULT branch only. This step dates from the main-only workflow, when
# every push WAS main; since branches + PRs (2026-09-25) it ran on every feature-branch push and
# shipped UNMERGED tooling into every consumer (seen repeatedly on 2026-10-10, including a branch
# whose PR was still under review). A branch push now says so and skips; after a PR merges,
# sync from an up-to-date default branch (`npm run sync`, then `npm run sync:pr`).
# The sync copies THIS CHECKOUT's files, so it must also BE the commit going to the default branch:
# `git push origin feature:main` from a feature worktree would otherwise publish the feature tree.
SYNC_SCRIPT="$REPO_ROOT/scripts/sync-to-repos.mjs"
CHECKOUT_SHA="$(git rev-parse HEAD 2>/dev/null)"
if [ -f "$SYNC_SCRIPT" ] && [ "$PUSHES_DEFAULT" -ne 1 ]; then
  echo "→ Consumer sync skipped: this push does not update '$DEFAULT_BRANCH' — consumers receive the default branch only."
  echo "   After the PR merges, sync from an up-to-date $DEFAULT_BRANCH: node scripts/sync-to-repos.mjs"
elif [ -f "$SYNC_SCRIPT" ] && [ "$CHECKOUT_SHA" != "$DEFAULT_PUSH_SHA" ]; then
  echo "→ Consumer sync skipped: '$DEFAULT_BRANCH' is being updated to ${DEFAULT_PUSH_SHA:0:12}, but this checkout is at ${CHECKOUT_SHA:0:12} — the sync would publish the wrong tree."
  echo "   Sync from a checkout of the pushed $DEFAULT_BRANCH: node scripts/sync-to-repos.mjs"
elif [ -f "$SYNC_SCRIPT" ]; then
  echo "→ Syncing skills to consumer repos..."
  node "$SYNC_SCRIPT" 2>&1
  SYNC_STATUS=$?
  if [ $SYNC_STATUS -ne 0 ]; then
    # NOT "completed with warnings". The script exits non-zero for two very
    # different reasons — per-file errors after a real sync, and aborting
    # before copying anything (a failed cwd/root guard, a missing target) — and
    # the old wording claimed completion for both. On 2026-08-08 a push from a
    # git worktree hit the second case: consumers were never updated and the
    # hook said "Sync completed with warnings".
    #
    # Still non-blocking, deliberately: consumer repos are OTHER-MACHINE state,
    # and machine state may advise but must not block a push of this repo's own
    # verified commit. The fix is honesty about what happened, not a new gate.
    echo "✗  Sync FAILED (exit $SYNC_STATUS) — consumer repos were NOT updated."
    echo "   Your push continues; re-run from the repo root to sync them:"
    echo "     cd \"$REPO_ROOT\" && node scripts/sync-to-repos.mjs"
  else
    echo "✓  Sync complete"
  fi
fi

# ── 3. Opportunistic weekly local maintenance (opt-in, backgrounded) ─────
# The local replica of the 5 weekly GH Actions cron workflows. Consumer repos
# get this block from `scripts/install-prepush-hook.mjs`, which writes the
# CONSUMER path (scripts/.claude-skills/). This repo's hook is installed by a
# different script (install-git-hooks.mjs) and had no equivalent — so the
# source repo, alone among the repos it serves, could never run its own
# replica. `AUDIT_LOOP_WEEKLY_MAINTENANCE=1` was therefore inert here.
#
# That gap only started to matter once this repo's store moved off a
# cloud-reachable Postgres: a GitHub-hosted runner cannot reach a LAN address,
# so the scheduled workflows self-skip and the local replica is the only thing
# left that runs memory-health and learning-weekly-review for THIS repo.
#
# Always invoked; maintenance-checks.mjs decides whether the opt-in flag is set
# and whether a run is due — a silent no-op otherwise, so this costs nothing
# for anyone who has not opted in.
#
# BACKGROUNDED via `( … & )`, not `|| true`: `|| true` only suppresses the exit
# code, leaving `git push` blocked for up to ~35 min (7 checks x 5-min timeout)
# once overdue. Output goes to a log — read it with `npm run maintenance:status`.
MAINT_SCRIPT="$REPO_ROOT/scripts/maintenance-checks.mjs"
if [ -f "$MAINT_SCRIPT" ]; then
  mkdir -p "$REPO_ROOT/.audit-loop" 2>/dev/null
  ( cd "$REPO_ROOT" && node "$MAINT_SCRIPT" --opportunistic \
      > "$REPO_ROOT/.audit-loop/last-maintenance.log" 2>&1 < /dev/null & ) 2>/dev/null
fi

exit 0
