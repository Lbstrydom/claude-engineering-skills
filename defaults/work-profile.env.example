# ─────────────────────────────────────────────────────────────────────────────
# Azure AI Foundry "work profile" — example .env
#
# Copy the values you need into your repo `.env` OR (preferred for shared
# secrets) into `~/.audit-loop.env` (chmod 600, never committed). The Azure
# path is OPT-IN: it activates only when AZURE_OPENAI_ENDPOINT is set. With
# these vars absent, the bundle uses the public OpenAI/Gemini/Anthropic APIs
# exactly as before (byte-identical).
#
# See docs/azure-work-profile.md for the full deployment guide.
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure AI Foundry ─────────────────────────────────────────────────────────
# Your Azure AI Foundry / Azure OpenAI key (portal → Keys and Endpoint).
AZURE_OPENAI_API_KEY=

# Azure OpenAI endpoint — serves GPT (auditor) + embeddings.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com

# Azure AI Foundry endpoint — serves Claude/Opus (the final reviewer).
AZURE_AI_ENDPOINT=https://<your-resource>.services.ai.azure.com

# api-version for the v1 surface. The literal `preview` is CORRECT for the
# /openai/v1 surface (NOT a dated 2024-..-preview string). Override only if your
# resource is pinned to the legacy dated surface.
# AZURE_OPENAI_API_VERSION=preview

# ── Deployment names (these are your Azure *deployment* names, NOT model IDs) ──
# The GPT auditor deployment (e.g. a chat deployment of GPT-5.3).
AZURE_OPENAI_GPT_DEPLOYMENT=gpt-5.3-chat

# The Opus deployment that REPLACES Gemini as the final reviewer.
AZURE_FOUNDRY_CLAUDE_DEPLOYMENT=opus-4-6

# Embedding deployment (defaults to text-embedding-3-small if unset).
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# How Foundry serves Claude: `openai` (default — OpenAI-shaped chat-completions)
# or `anthropic` (native Anthropic Messages via baseURL). Leave default unless a
# live smoke shows your Foundry deployment speaks the native Anthropic API.
# AZURE_CLAUDE_API_SHAPE=openai

# Foundry inference path. Default `/openai/v1`; some Foundry Serverless
# deployments route non-OpenAI models at `/models` — flip here if the live
# smoke 404s. (Manual-verification-required against your endpoint.)
# AZURE_FOUNDRY_API_PATH=/openai/v1

# ── Logical model sentinels (KEEP as sentinels — NOT deployment names) ─────────
# These stay on the normal sentinel contract for logging/pricing. The Azure
# wire-level model comes from the AZURE_*_DEPLOYMENT vars above. Leaving these
# commented uses the defaults (latest-gpt / latest-opus).
# OPENAI_AUDIT_MODEL=latest-gpt
# CLAUDE_FINAL_REVIEW_MODEL=latest-opus

# The live model catalog 404s against Azure-only access, so it's auto-skipped
# when the Azure profile is active. Set explicitly only to be belt-and-braces.
# MODEL_CATALOG_REFRESH=skip

# ── Postgres store (local for now; AWS/Azure-managed is just a different DSN) ──
# Canonical names. The legacy AUDIT_POSTGRES_URL / AUDIT_POSTGRES_SSL_MODE
# aliases still work (with a one-time deprecation notice).
AUDIT_DB_URL=postgres://postgres:<password>@localhost:5432/audit_loop
AUDIT_DB_SSL_MODE=disable
# AUDIT_STORE=postgres   # optional; if set, a missing DSN fails fast (no silent local-only).
